{
  "name": "poke-type-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deadcode": "knip",
    "verify": "tsx harness/verify.ts",
    "progress": "tsx harness/progress.ts",
    "compact": "tsx harness/compact.ts",
    "entropy": "tsx harness/entropy.ts",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
