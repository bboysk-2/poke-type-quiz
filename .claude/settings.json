{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify:*)",
      "Bash(pnpm progress:*)",
      "Bash(pnpm compact:*)",
      "Bash(pnpm entropy:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)"
    ],
    "deny": ["Edit(todo.json)", "Write(todo.json)", "Edit(progress.md)", "Write(progress.md)"]
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/tsx \"$CLAUDE_PROJECT_DIR\"/harness/hooks/sessionStart.ts" }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/tsx \"$CLAUDE_PROJECT_DIR\"/harness/hooks/preCompact.ts" }] }],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/tsx \"$CLAUDE_PROJECT_DIR\"/harness/hooks/planGate.ts" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/tsx \"$CLAUDE_PROJECT_DIR\"/harness/hooks/lintOnEdit.ts", "timeout": 60 }] }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/tsx \"$CLAUDE_PROJECT_DIR\"/harness/hooks/stopGate.ts", "timeout": 300 }] }],
    "SubagentStop": [{ "matcher": "implementer", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/tsx \"$CLAUDE_PROJECT_DIR\"/harness/hooks/stopGate.ts", "timeout": 300 }] }]
  }
}
